rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && (request.auth.token.firebase.sign_in_provider == 'google.com'
        || (request.auth.token.firebase.sign_in_provider == 'password' && 'playReview' in request.auth.token && request.auth.token.playReview == true));
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function profile(uid) { return get(/databases/$(database)/documents/players/$(uid)).data; }
    function acceptedTerms(uid) { return profile(uid).termsVersion == '2026-10-13'; }
    function validName(name) { return name is string && name.matches('^[가-힣a-zA-Z0-9_]{2,12}$'); }
    function validMap(map) { return map in ['willow', 'lotus', 'moon', 'gold']; }
    function openMap(map) { return map == 'willow'; }
    // src/game/fisheries.ts의 FISHERY_CAPACITY=24, presence.ts의 LEASE_MS=150000과 함께 관리한다.
    function validSlot(slot) { return slot.matches('^([0-9]|1[0-9]|2[0-3])$'); }
    function membership(map, slot, session) {
      let seat = get(/databases/$(database)/documents/presence/$(map)/slots/$(slot)).data;
      return openMap(map) && validSlot(slot) && seat.uid == request.auth.uid && seat.sessionId == session
        && seat.updatedAt > request.time - duration.value(150, 's');
    }
    function validSpecies(id) { return id in ['crucian', 'carp', 'mirror', 'bluegill', 'catfish', 'yellowcat', 'snakehead', 'mandarin', 'bass', 'hera', 'nuchi', 'koi', 'leather', 'bredmirror', 'grasscarp']; }
    function maxLength(id) { return {'crucian':55, 'carp':110, 'mirror':90, 'bluegill':25, 'catfish':115, 'yellowcat':42, 'snakehead':110, 'mandarin':65, 'bass':65, 'hera':60, 'nuchi':75, 'koi':100, 'leather':100, 'bredmirror':100, 'grasscarp':110}[id]; }
    function validProfile(uid) {
      let d = request.resource.data;
      return owner(uid) && d.keys().hasOnly(['uid','nickname','nicknameKey','createdAt','updatedAt','lastChatAt','lastMessageId','termsVersion','termsAcceptedAt'])
        && d.termsVersion == '2026-10-13' && d.termsAcceptedAt is timestamp
        && d.uid == uid && validName(d.nickname) && d.nicknameKey == d.nickname.lower()
        && (!('lastMessageId' in d) || (d.lastMessageId is string && d.lastMessageId.size() <= 40))
        && d.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/nicknames/$(d.nicknameKey)).data.uid == uid;
    }
    match /players/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create: if validProfile(uid) && request.resource.data.createdAt == request.time && request.resource.data.termsAcceptedAt == request.time && !('lastChatAt' in request.resource.data);
      allow update: if validProfile(uid) && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','nicknameKey','updatedAt','lastChatAt','lastMessageId','termsVersion','termsAcceptedAt'])
        && (request.resource.data.termsAcceptedAt == request.time || (resource.data.termsVersion == '2026-10-13' && request.resource.data.termsAcceptedAt == resource.data.termsAcceptedAt))
        && (!('lastChatAt' in resource.data) || ('lastChatAt' in request.resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastChatAt']) || request.resource.data.lastChatAt == request.time);
    }
    // 진행 저장 (src/game/profileSync.ts). 본인만 읽고 쓰며, 내용은 클라이언트가 만든 JSON 문자열이다.
    // 같은 문서를 2초 안에 다시 쓰지 못하게 해 쓰기 폭주를 막는다.
    match /saves/{uid} {
      function validSave() {
        let d = request.resource.data;
        return owner(uid) && d.keys().hasOnly(['json','savedAt','version','updatedAt'])
          && d.json is string && d.json.size() > 2 && d.json.size() <= 950000
          && d.savedAt is number && d.version == 1 && d.updatedAt == request.time;
      }
      allow get: if owner(uid);
      allow list: if false;
      allow create: if validSave();
      allow update: if validSave() && resource.data.updatedAt <= request.time - duration.value(2, 's');
      allow delete: if owner(uid);
    }
    match /nicknames/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['uid','nickname'])
        && request.resource.data.uid == request.auth.uid && validName(request.resource.data.nickname)
        && key == request.resource.data.nickname.lower()
        && (!exists(/databases/$(database)/documents/nicknames/$(key)) || resource.data.uid == request.auth.uid)
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.nicknameKey == key;
      allow delete: if owner(resource.data.uid)
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.nicknameKey != key;
    }
    match /presence/{map}/slots/{slot} {
      allow get: if signedIn() && validMap(map) && validSlot(slot);
      allow list: if signedIn() && validMap(map) && request.query.limit != null && request.query.limit <= 24;
      function validRemoteRod(rod) {
        return rod is map && rod.keys().hasAll(['slotId','rodId']) && rod.keys().hasOnly(['slotId','rodId'])
          && rod.slotId is string && rod.slotId.matches('^[1-8]-[1-3]-[1-3]$')
          && rod.rodId in ['starter','long','power','light','carbon','legend','memphis','grand','gold','mugung','willow-soft','willow-finesse','willow-guard','willow-master'];
      }
      function validRemoteRodSlots(rodSlots) {
        return rodSlots is list && rodSlots.size() <= 3
          && (rodSlots.size() < 1 || validRemoteRod(rodSlots[0]))
          && (rodSlots.size() < 2 || validRemoteRod(rodSlots[1]))
          && (rodSlots.size() < 3 || validRemoteRod(rodSlots[2]));
      }
      function validHeldRod(held) {
        return held == null || (held is map
          && held.keys().hasAll(['rodId','buttX','buttY','buttZ','dirX','dirY','dirZ'])
          && held.keys().hasOnly(['rodId','buttX','buttY','buttZ','dirX','dirY','dirZ'])
          && held.rodId in ['starter','long','power','light','carbon','legend','memphis','grand','gold','mugung','willow-soft','willow-finesse','willow-guard','willow-master']
          && held.buttX is number && held.buttX >= -2000 && held.buttX <= 2000
          && held.buttY is number && held.buttY >= -50 && held.buttY <= 100
          && held.buttZ is number && held.buttZ >= -2000 && held.buttZ <= 2000
          && held.dirX is number && held.dirX >= -1 && held.dirX <= 1
          && held.dirY is number && held.dirY >= -1 && held.dirY <= 1
          && held.dirZ is number && held.dirZ >= -1 && held.dirZ <= 1);
      }
      function validRemotePose(d) {
        return !d.keys().hasAny(['x','z','yaw','rodSlots','heldRod']) || (d.keys().hasAll(['x','z','yaw','rodSlots','heldRod'])
          && d.x is number && d.x >= -2000 && d.x <= 2000
          && d.z is number && d.z >= -2000 && d.z <= 2000
          && d.yaw is number && d.yaw >= -7 && d.yaw <= 7
          && validRemoteRodSlots(d.rodSlots) && validHeldRod(d.heldRod));
      }
      function validSeat() {
        let d = request.resource.data;
        return signedIn() && acceptedTerms(request.auth.uid) && openMap(map) && validSlot(slot)
          && d.keys().hasAll(['uid','nickname','sessionId','updatedAt'])
          && d.keys().hasOnly(['uid','nickname','sessionId','updatedAt','x','z','yaw','rodSlots','heldRod'])
          && d.uid == request.auth.uid && d.nickname == profile(request.auth.uid).nickname
          && d.sessionId is string && d.sessionId.size() == 36 && d.updatedAt == request.time
          && validRemotePose(d);
      }
      allow create: if validSeat();
      allow update: if validSeat() && (owner(resource.data.uid) || resource.data.updatedAt <= request.time - duration.value(150, 's'));
      allow delete: if owner(resource.data.uid);
    }
    match /rooms/{map}/messages/{id} {
      allow get: if signedIn() && validMap(map);
      allow list: if signedIn() && validMap(map) && request.query.limit != null && request.query.limit <= 50;
      function validMessageBase() {
        let d = request.resource.data;
        return signedIn() && acceptedTerms(request.auth.uid) && validMap(map)
          && membership(map, d.slotId, d.sessionId)
          && d.uid == request.auth.uid && d.nickname == profile(request.auth.uid).nickname
          && d.createdAt == request.time;
      }
      function validChatMessage() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid','nickname','text','createdAt','slotId','sessionId'])
          && d.text is string && d.text.size() > 0 && d.text.size() <= 200
        && (!('lastChatAt' in profile(request.auth.uid)) || profile(request.auth.uid).lastChatAt <= request.time - duration.value(3, 's'))
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.lastChatAt == request.time
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.lastMessageId == id;
      }
      function validCatchMessage() {
        let d = request.resource.data;
        return d.keys().hasAll(['kind','catchId','uid','nickname','speciesId','cm','kg','createdAt','slotId','sessionId'])
          && d.keys().hasOnly(['kind','catchId','uid','nickname','speciesId','cm','kg','createdAt','slotId','sessionId'])
          && d.kind == 'catch' && d.catchId is string
          && d.catchId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
          && id == 'catch_' + request.auth.uid + '_' + d.catchId
          && validSpecies(d.speciesId) && d.cm is number && d.cm >= 6 && d.cm <= maxLength(d.speciesId)
          && d.kg is number && d.kg > 0 && d.kg <= 100;
      }
      allow create: if validMessageBase() && (validCatchMessage() || validChatMessage());
      allow update, delete: if false;
    }
    match /leaderboards/{scope}/species/{species}/entries/{uid} {
      allow get: if validSpecies(species) && (scope == 'all' || validMap(scope));
      allow list: if validSpecies(species) && (scope == 'all' || validMap(scope)) && request.query.limit != null && request.query.limit <= 20;
      function validEntry() {
        let d = request.resource.data;
        return owner(uid) && acceptedTerms(uid) && validSpecies(species) && (scope == 'all' || validMap(scope))
          && d.keys().hasOnly(['uid','nickname','cm','kg','fisheryId','updatedAt'])
          && d.uid == uid && d.nickname == profile(uid).nickname
          && d.cm is number && d.cm >= 6 && d.cm <= maxLength(species)
          && d.kg is number && d.kg > 0 && d.kg <= 100 && validMap(d.fisheryId)
          && (scope == 'all' || d.fisheryId == scope) && d.updatedAt == request.time;
      }
      allow create: if validEntry();
      allow update: if validEntry() && request.resource.data.cm >= resource.data.cm;
      allow delete: if false;
    }
    match /reports/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['reporterUid','targetUid','targetNickname','map','messageId','reason','createdAt'])
        && request.resource.data.keys().hasOnly(['reporterUid','targetUid','targetNickname','map','messageId','reason','createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.targetNickname is string && request.resource.data.targetNickname.size() <= 12
        && validMap(request.resource.data.map)
        && request.resource.data.messageId is string && request.resource.data.messageId.size() <= 100
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt == request.time
        && id == request.auth.uid + '_' + request.resource.data.targetUid + '_' + (request.resource.data.messageId == '' ? 'profile' : request.resource.data.messageId)
        && (request.resource.data.messageId == ''
          ? exists(/databases/$(database)/documents/players/$(request.resource.data.targetUid))
          : get(/databases/$(database)/documents/rooms/$(request.resource.data.map)/messages/$(request.resource.data.messageId)).data.uid == request.resource.data.targetUid);
    }
  }
}
